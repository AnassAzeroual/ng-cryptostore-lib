{
  "name": "ng-cryptostore-lib",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build ng-cryptostore --configuration production",
    "build:demo": "ng build cryptostore-test-demo --configuration production",
    "watch": "ng build ng-cryptostore --watch --configuration development",
    "pack": "npm run build && cd dist/ng-cryptostore && npm pack",
    "publish:lib": "npm run build && npm publish ./dist/ng-cryptostore",
    "publish:local": "npm run build && npm publish ./dist/ng-cryptostore --registry http://localhost:4873",
    "tests": "npm run build",
    "test": "ng test ng-cryptostore",
    "test:ci": "ng test ng-cryptostore --watch=false --browsers=ChromeHeadlessCI",
    "test:coverage": "ng test ng-cryptostore --watch=false --browsers=ChromeHeadlessCI --code-coverage",
    "test:demo": "ng test cryptostore-test-demo --watch=false --browsers=ChromeHeadlessCI"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-browser-dynamic": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "^21.0.0",
    "@types/crypto-js": "^4.2.0",
    "@types/jasmine": "~5.1.0",
    "crypto-js": "^4.2.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^21.2.0",
    "typescript": "~5.9.0"
  }
}
