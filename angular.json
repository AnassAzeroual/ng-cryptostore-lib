{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ng-cryptostore": {
      "projectType": "library",
      "root": "projects/ng-cryptostore",
      "sourceRoot": "projects/ng-cryptostore/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/ng-cryptostore/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ng-cryptostore/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ng-cryptostore/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/ng-cryptostore/tsconfig.spec.json",
            "karmaConfig": "projects/ng-cryptostore/karma.conf.js"
          }
        }
      }
    },
    "cryptostore-test-demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/cryptostore-test-demo",
      "sourceRoot": "projects/cryptostore-test-demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "preserveSymlinks": true,
            "outputPath": "dist/cryptostore-test-demo",
            "index": "projects/cryptostore-test-demo/src/index.html",
            "browser": "projects/cryptostore-test-demo/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "projects/cryptostore-test-demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/cryptostore-test-demo/src/assets"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/cryptostore-test-demo/src"
              }
            ],
            "styles": [
              "projects/cryptostore-test-demo/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "cryptostore-test-demo:build:production"
            },
            "development": {
              "buildTarget": "cryptostore-test-demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "cryptostore-test-demo:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "projects/cryptostore-test-demo/tsconfig.spec.json",
            "karmaConfig": "projects/cryptostore-test-demo/karma.conf.js",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/cryptostore-test-demo/src/assets"
              },
              {
                "glob": "favicon.ico",
                "input": "projects/cryptostore-test-demo/src"
              }
            ],
            "styles": [
              "projects/cryptostore-test-demo/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}